# production environment — bundle id com.myapptemplate
#
# Production values, for debugging production behaviour locally. Real production builds read the "production" EAS environment declared in eas.json, not this file.
#
# Activate it with:
#   pnpm env:use production
#
# That copies this file onto .env.local, which is git-ignored and which Expo
# loads with precedence. There is no committed .env: every value below has to
# come from a local file you create, or from the environment in CI.

# Application environment: development | preview | production
# Selects BUNDLE_IDS / PACKAGES / SCHEMES in env.ts.
EXPO_PUBLIC_APP_ENV=production

# API base URL. Required — env.ts validates it as a URL.
EXPO_PUBLIC_API_URL=https://api.example.com/

# Universal links / app links domain. Optional, must be a URL when set.
# EXPO_PUBLIC_ASSOCIATED_DOMAIN=https://example.com

# Build-time only. No EXPO_PUBLIC_ prefix, so it is NOT inlined into the
# JavaScript bundle and cannot be read from src/.
APP_BUILD_ONLY_VAR=build-only-value

# Real secrets do not belong in any EXPO_PUBLIC_ variable: those ship in plain
# text inside the app binary. Use EAS environment variables for those.
