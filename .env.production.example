# Production environment — bundle id com.myapptemplate
#
# Copy to .env.local to activate:
#   cp .env.production.example .env.local
#
# Running production values locally is for debugging only. Real production
# builds take their values from the "production" EAS environment declared in
# eas.json, not from this file.

# Application environment: development | preview | production
# Selects BUNDLE_IDS / PACKAGES / SCHEMES in env.ts.
EXPO_PUBLIC_APP_ENV=production

# API base URL. Required — env.ts validates it as a URL.
EXPO_PUBLIC_API_URL=https://api.example.com/

# Universal links / app links domain. Optional, must be a URL when set.
# EXPO_PUBLIC_ASSOCIATED_DOMAIN=https://example.com

# Example typed variables, parsed by env.ts as number and boolean.
EXPO_PUBLIC_VAR_NUMBER=10
EXPO_PUBLIC_VAR_BOOL=true

# Build-time only. No EXPO_PUBLIC_ prefix, so it is NOT inlined into the
# JavaScript bundle and is not readable from src/.
APP_BUILD_ONLY_VAR=build-only-value

# Real secrets do not belong here. Anything prefixed EXPO_PUBLIC_ ships in
# plain text inside the app binary. Use EAS environment variables instead.
